// Alloy config for the alloy HelmRelease. Rendered into the ConfigMap
// alloy-agent-config by kustomization.yaml; the chart's config-reloader picks up changes.
// Kept as a file (same as syslog.alloy) so both configs are edited the same way.

// ---------------------------------------------------------------------
// Pod logs on this node
// ---------------------------------------------------------------------
discovery.kubernetes "pods" {
  role = "pod"
  selectors {
    role  = "pod"
    field = "spec.nodeName=" + sys.env("NODE_NAME")
  }
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  // skip pods that are not running yet / already gone
  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex         = "Pending|Succeeded|Failed|Completed"
    action        = "drop"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label  = "node"
  }
  // app = app.kubernetes.io/name, falling back to the legacy app label
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_label_app"]
    separator     = ";"
    regex         = ";*([^;]+).*"
    target_label  = "app"
  }
  rule {
    replacement  = "kubernetes-pods"
    target_label = "job"
  }
  // One target per container and exactly that container's files.
  // (Promtail globbed the whole pod per container, multiplying lines)
  rule {
    source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
    separator     = "/"
    target_label  = "__path__"
    replacement   = "/var/log/pods/*$1/*.log"
  }
}

local.file_match "pods" {
  path_targets = discovery.relabel.pods.output
}

loki.source.file "pods" {
  targets    = local.file_match.pods.targets
  forward_to = [loki.process.pods.receiver]
}

loki.process "pods" {
  stage.cri {}

  // file path contains the pod UID: pure stream churn, pod/container say the same
  stage.label_drop {
    values = ["filename"]
  }

  // Noise that costs disk and is never read: probe and scrape requests
  stage.drop {
    expression          = "(kube-probe/|Prometheus/|GET /(healthz|readyz|livez|health|ping|metrics)[ ?\"])"
    drop_counter_reason = "healthchecks"
  }

  // pull a log level out of common formats, as structured metadata (not a label)
  stage.regex {
    expression = "(?i)(?:level|lvl|severity)[\"=: ]+\"?(?P<level>debug|info|warn|warning|error|err|fatal|critical)"
  }
  stage.structured_metadata {
    values = { level = "" }
  }

  forward_to = [loki.write.default.receiver]
}

// ---------------------------------------------------------------------
// Ship to Loki
// ---------------------------------------------------------------------
loki.write "default" {
  endpoint {
    url = "http://loki.monitoring.svc.cluster.local:3100/loki/api/v1/push"
    // fewer, larger pushes
    batch_wait = "5s"
    batch_size = "1MiB"
  }
}

