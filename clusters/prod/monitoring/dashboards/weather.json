    {
      "id": 10,
      "type": "table",
      "title": "7-day forecast",
      "gridPos": {
        "h": 13,
        "w": 9,
        "x": 15,
        "y": 12
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://api.open-meteo.com/v1/forecast",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "latitude",
                "value": "${lat}"
              },
              {
                "key": "longitude",
                "value": "${lon}"
              },
              {
                "key": "temperature_unit",
                "value": "fahrenheit"
              },
              {
                "key": "wind_speed_unit",
                "value": "mph"
              },
              {
                "key": "precipitation_unit",
                "value": "inch"
              },
              {
                "key": "timezone",
                "value": "auto"
              },
              {
                "key": "timeformat",
                "value": "unixtime"
              },
              {
                "key": "daily",
                "value": "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,uv_index_max,sunrise,sunset"
              },
              {
                "key": "forecast_days",
                "value": "7"
              }
            ]
          },
          "root_selector": "($map(daily.time, function($v, $i) {{\"day\": $v * 1000, \"condition\": $$.daily.weather_code[$i], \"high\": $$.daily.temperature_2m_max[$i], \"low\": $$.daily.temperature_2m_min[$i], \"rain\": $$.daily.precipitation_probability_max[$i], \"uv\": $$.daily.uv_index_max[$i], \"sunrise\": $$.daily.sunrise[$i] * 1000, \"sunset\": $$.daily.sunset[$i] * 1000}}))",
          "columns": [
            {
              "selector": "day",
              "text": "Day",
              "type": "number"
            },
            {
              "selector": "condition",
              "text": "Forecast",
              "type": "number"
            },
            {
              "selector": "high",
              "text": "High",
              "type": "number"
            },
            {
              "selector": "low",
              "text": "Low",
              "type": "number"
            },
