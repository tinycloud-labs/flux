{
  "uid": "homelab_weather",
  "title": "Weather",
  "tags": [
    "homelab",
    "kiosk"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "graphTooltip": 0,
  "refresh": "10m",
  "time": {
    "from": "now",
    "to": "now+24h"
  },
  "timepicker": {
    "hidden": true
  },
  "description": "Current weather and 7-day forecast for Redlands, CA (Open-Meteo, via the Infinity datasource), plus world clocks. Part of the kiosk rotation.",
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "lat",
        "label": "Latitude",
        "query": "34.06",
        "hide": 2
      },
      {
        "type": "constant",
        "name": "lon",
        "label": "Longitude",
        "query": "-117.18",
        "hide": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Now",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://api.open-meteo.com/v1/forecast",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "latitude",
                "value": "${lat}"
              },
              {
                "key": "longitude",
                "value": "${lon}"
              },
              {
                "key": "temperature_unit",
                "value": "fahrenheit"
              },
              {
                "key": "wind_speed_unit",
                "value": "mph"
              },
              {
                "key": "precipitation_unit",
                "value": "inch"
              },
              {
                "key": "timezone",
                "value": "auto"
              },
              {
                "key": "timeformat",
                "value": "unixtime"
              },
              {
                "key": "current",
                "value": "temperature_2m,apparent_temperature,relative_humidity_2m,weather_code,wind_speed_10m,wind_gusts_10m,is_day"
              }
            ]
          },
          "root_selector": "([current.{\"time\": time * 1000, \"temp\": temperature_2m, \"feels\": apparent_temperature, \"humidity\": relative_humidity_2m, \"wind\": wind_speed_10m, \"gusts\": wind_gusts_10m, \"condition\": weather_code + ((is_day = 0 and weather_code <= 2) ? 100 : 0)}])",
          "columns": [
            {
              "selector": "time",
              "text": "Updated",
              "type": "timestamp_epoch"
            },
            {
              "selector": "condition",
              "text": "Condition",
              "type": "number"
            },
            {
              "selector": "temp",
              "text": "Temperature",
              "type": "number"
            },
            {
              "selector": "feels",
              "text": "Feels like",
              "type": "number"
            },
            {
              "selector": "humidity",
              "text": "Humidity",
              "type": "number"
            },
            {
              "selector": "wind",
              "text": "Wind",
              "type": "number"
            },
            {
              "selector": "gusts",
              "text": "Gusts",
              "type": "number"
            }
          ],
          "filters": []
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Condition$/"
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
