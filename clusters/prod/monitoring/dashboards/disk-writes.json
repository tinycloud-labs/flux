        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{storageIODevice}}",
          "expr": "storageIOLA{job=\"synology-health\", storageIODevice=~\"sata[0-9]+|sd[a-z]+\"}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Temperature & bad sectors",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* temp"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* bad sectors"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.drawStyle",
                "value": "bars"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{diskID}} temp",
          "expr": "diskTemperature{job=\"synology-health\"}"
        },
        {
          "refId": "B",
          "legendFormat": "{{diskID}} bad sectors",
          "expr": "diskBadSector{job=\"synology-health\"}"
        }
      ]
    },
    {
      "id": 104,
      "type": "row",
      "title": "Capacity trend",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 57
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Fullest Proxmox CSI volumes (SSD pool)",
      "description": "PVCs on proxmox-* storage classes. A steadily rising line is the Gaseous pattern.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 58
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{namespace}}/{{persistentvolumeclaim}}",
          "expr": "max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes) * on (namespace, persistentvolumeclaim) group_left kube_persistentvolumeclaim_info{storageclass=~\"proxmox.*\"}"
        }
      ]
    }
  ]
}