{
  "uid": "homelab_alert_history",
  "title": "Alert history",
  "description": "What fired, for how long, and whether Discord got it. Use it to tune thresholds so alerts stay rare.",
  "tags": [
    "homelab",
    "alerts"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Homelab",
      "type": "link",
      "url": "/d/homelab_home",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Firing now",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Critical"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Warning"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\", severity=\"critical\"}) or vector(0)",
          "legendFormat": "Critical",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "count(ALERTS{alertstate=\"firing\", severity=\"warning\"}) or vector(0)",
          "legendFormat": "Warning",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "In the selected range",
      "gridPos": {
        "h": 4,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failed deliveries"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (alertname) (max_over_time(ALERTS{alertstate=\"firing\", alertname!~\"Watchdog|InfoInhibitor\"}[$__range]))) or vector(0)",
          "legendFormat": "Distinct alerts fired",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum(increase(alertmanager_notifications_total{integration=\"discord\"}[$__range]))",
          "legendFormat": "Discord messages",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "sum(increase(alertmanager_notifications_failed_total[$__range])) or vector(0)",
          "legendFormat": "Failed deliveries",
          "instant": true
        }
      ],
      "description": "Metric-based alerts only. Log-based (Loki ruler) alerts go straight to Alertmanager and are counted in Discord messages, not in ALERTS."
    },
    {
      "id": 3,
      "type": "state-timeline",
      "title": "Timeline (firing)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "warning"
                },
                "2": {
                  "text": "critical"
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (alertname) (ALERTS{alertstate=\"firing\", severity=\"warning\", alertname!~\"Watchdog|InfoInhibitor\"}) or max by (alertname) (ALERTS{alertstate=\"firing\", severity=\"critical\", alertname!~\"Watchdog|InfoInhibitor\"}) * 2",
          "legendFormat": "{{alertname}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Noisiest alerts (time firing in range)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time firing"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time firing",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "alertname": true,
              "severity": true,
              "Value": true
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "Value": "Time firing"
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "Value": 2
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (alertname, severity) (count_over_time(ALERTS{alertstate=\"firing\", alertname!~\"Watchdog|InfoInhibitor\"}[$__range])) * 60)",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Rules are evaluated every 60s, so each firing sample is one minute. Tune or silence whatever sits at the top."
    },
    {
      "id": 5,
      "type": "table",
      "title": "Firing now (with start time)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "Nothing firing"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Since",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "alertname": true,
              "severity": true,
              "where": true,
              "Value": true
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "where": "Where",
              "Value": "Since"
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "where": 2,
              "Value": 3
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "label_join(ALERTS_FOR_STATE{alertname!~\"Watchdog|InfoInhibitor\"} and ignoring (alertstate) ALERTS{alertstate=\"firing\"}, \"where\", \" \", \"namespace\", \"pod\", \"persistentvolumeclaim\", \"name\", \"host\", \"diskID\", \"raidName\", \"hrStorageDescr\") * 1000",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Alertmanager notifications",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "showPoints": "never",
            "fillOpacity": 60,
            "drawStyle": "bars"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (integration) (increase(alertmanager_notifications_total[$__interval]))",
          "legendFormat": "{{integration}} sent"
        },
        {
          "refId": "B",
          "expr": "sum by (integration) (increase(alertmanager_notifications_failed_total[$__interval]))",
          "legendFormat": "{{integration}} failed"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Alerts in Alertmanager (incl. log-based)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "showPoints": "never",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (alertmanager_alerts)",
          "legendFormat": "{{state}}"
        }
      ],
      "description": "active = being notified; suppressed = silenced or inhibited."
    }
  ]
}
