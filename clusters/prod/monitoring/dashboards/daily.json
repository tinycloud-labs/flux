    {
      "id": 6,
      "type": "stat",
      "title": "Moon",
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity"
          },
          "type": "json",
          "source": "inline",
          "parser": "backend",
          "format": "table",
          "root_selector": "(\n  $syn := 29.530588853 * 86400000;\n  $t := $toMillis($now());\n  $f := (($t - 947182440000) % $syn) / $syn;\n  $x := 3.141592653589793 * $f;\n  $s := 16 * $x * (3.141592653589793 - $x) / (5 * 9.869604401089358 - 4 * $x * (3.141592653589793 - $x));\n  [{\n    \"phase\": $floor($f * 8 + 0.5) % 8,\n    \"illum\": $round($s * $s * 100),\n    \"age\": $f * 29.530588853,\n    \"nextFull\": $t + ($f < 0.5 ? 0.5 - $f : 1.5 - $f) * $syn,\n    \"nextNew\": $t + (1 - $f) * $syn\n  }]\n)",
          "columns": [
            {
              "selector": "phase",
              "text": "Phase",
              "type": "number"
            },
            {
              "selector": "illum",
              "text": "Illuminated",
              "type": "number"
            },
            {
              "selector": "age",
              "text": "Age",
              "type": "number"
            },
            {
              "selector": "nextFull",
              "text": "Next full moon",
              "type": "number"
            },
            {
              "selector": "nextNew",
              "text": "Next new moon",
              "type": "number"
            }
          ],
          "filters": [],
          "data": "{}"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Phase$/"
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#C0D8FF"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#C0D8FF",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "🌑 New moon",
                  "index": 0
                },
                "1": {
                  "text": "🌒 Waxing crescent",
                  "index": 1
                },
                "2": {
                  "text": "🌓 First quarter",
                  "index": 2
                },
                "3": {
                  "text": "🌔 Waxing gibbous",
                  "index": 3
                },
                "4": {
                  "text": "🌕 Full moon",
                  "index": 4
                },
                "5": {
                  "text": "🌖 Waning gibbous",
                  "index": 5
                },
                "6": {
                  "text": "🌗 Last quarter",
                  "index": 6
                },
                "7": {
                  "text": "🌘 Waning crescent",
                  "index": 7
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "Computed from the mean lunar cycle (29.53 days); dates can be off by up to about half a day."
    },
