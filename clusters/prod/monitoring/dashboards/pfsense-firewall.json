{
  "uid": "homelab_pfsense",
  "title": "pfSense / Firewall",
  "tags": [
    "geoip",
    "homelab",
    "logs",
    "pfsense",
    "snmp"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "iface",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "iface",
          "stream": "{job=\"syslog\", app=\"filterlog\"}",
          "type": 1
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Line contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 12,
      "type": "row",
      "title": "Where blocked traffic comes from (GeoLite2)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "geomap",
      "title": "Blocked connections by source country",
      "description": "Counts from alloy-geoip (homelab_pfsense_blocked_total). Private/LAN sources are not counted. IP geolocation by MaxMind GeoLite2.",
      "gridPos": {
        "h": 12,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-YlRd"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "zero",
          "zoom": 1,
          "allLayers": true
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": false,
          "showAttribution": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "tooltip": {
          "mode": "details"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Blocked",
            "tooltip": true,
            "location": {
              "mode": "lookup",
              "lookup": "country_code",
              "gazetteer": "public/gazetteer/countries.json"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "field": "Value",
                  "min": 4,
                  "max": 30,
                  "fixed": 5
                },
                "color": {
                  "field": "Value"
                },
                "opacity": 0.65,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            }
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (country_code, country) (increase(homelab_pfsense_blocked_total[$__range])) > 0",
          "legendFormat": "{{country_code}}",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 14,
      "type": "table",
      "title": "Top countries (range)",
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No GeoIP data yet"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Blocked"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Code"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 60
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Blocked",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "country": true,
              "country_code": true,
              "Value": true
            },
            "renameByName": {
              "country": "Country",
              "country_code": "Code",
              "Value": "Blocked"
            },
            "indexByName": {
              "country": 0,
              "country_code": 1,
              "Value": 2
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (country, country_code) (increase(homelab_pfsense_blocked_total[$__range]))) > 0",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "Firewall blocks",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Blocked connections by interface",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (iface) (count_over_time({job=\"syslog\", app=\"filterlog\", action=\"block\", iface=~\"$iface\"} [$__auto]))",
          "legendFormat": "{{iface}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Blocked (range)",
      "description": "Blocked connections in the selected range. pfSense logs blocks only: passed traffic is not logged, so there is nothing to compare against.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"syslog\", app=\"filterlog\", action=\"block\", iface=~\"$iface\"} [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Blocked per minute (now)",
      "description": "Average blocks per minute over the last 5 minutes.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"syslog\", app=\"filterlog\", action=\"block\", iface=~\"$iface\"} [5m])) / 5"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top blocked sources",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "labelsToFields": true
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "approx_topk(15, sum by (src_ip) (count_over_time({job=\"syslog\", app=\"filterlog\", action=\"block\", iface=~\"$iface\"} [$__range])))",
          "legendFormat": "{{src_ip}}"
        }
      ],
      "description": "Addresses that were blocked most often in the selected range (approx_topk: exact for the leaders, approximate further down)."
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top blocked destination ports",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "labelsToFields": true
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "approx_topk(15, sum by (dst_port, proto) (count_over_time({job=\"syslog\", app=\"filterlog\", action=\"block\", iface=~\"$iface\"} | dst_port != \"\" [$__range])))",
          "legendFormat": "{{proto}}/{{dst_port}}"
        }
      ],
      "description": "Destination ports blocked most often in the selected range (approx_topk)."
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top blocked destinations",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "labelsToFields": true
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "approx_topk(15, sum by (dst_ip) (count_over_time({job=\"syslog\", app=\"filterlog\", action=\"block\", iface=~\"$iface\"} [$__range])))",
          "legendFormat": "{{dst_ip}}"
        }
      ],
      "description": "Addresses that blocked traffic was aimed at most often (approx_topk). Replaces 'Top passed destinations': pfSense does not log passed traffic."
    },
    {
      "id": 8,
      "type": "row",
      "title": "pfSense system (SNMP)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "stat",
      "title": "SNMP",
      "description": "Whether Prometheus can reach pfSense over SNMP.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"pfsense\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "OK",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "no data",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Version",
      "description": "pfSense edition and release, from the SNMP system description.",
      "gridPos": {
        "h": 4,
        "w": 7,
        "x": 3,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "{{version}}",
          "expr": "max by (version) (label_replace(sysDescr{job=\"pfsense\"}, \"version\", \"$1 $2\", \"sysDescr\", \"Netgate (.+?) \\\\S+ (\\\\S+) FreeBSD.*\"))"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Uptime",
      "description": "Time since pfSense's SNMP agent started, normally since boot.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sysUpTime{job=\"pfsense\"}) / 100",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "CPU",
      "description": "Average load across all CPU cores.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(hrProcessorLoad{job=\"pfsense\"})"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Memory",
      "description": "Memory used by processes, as a share of installed RAM. Excludes kernel and ZFS cache, so it reads lower than pfSense's own dashboard.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hrStorageSize{job=\"pfsense\", hrStorageDescr=\"Real Memory Metrics\"} * hrStorageAllocationUnits{job=\"pfsense\", hrStorageDescr=\"Real Memory Metrics\"}) / max(hrMemorySize{job=\"pfsense\"} * 1024) * 100"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 23,
      "type": "row",
      "title": "Resources",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "panels": []
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "CPU",
      "description": "CPU load, average and per core (HOST-RESOURCES-MIB). Dashed line: 90%, the alert threshold.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(hrProcessorLoad{job=\"pfsense\"})",
          "legendFormat": "average"
        },
        {
          "refId": "B",
          "expr": "hrProcessorLoad{job=\"pfsense\"}",
          "legendFormat": "{{hrDeviceDescr}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "showPoints": "never",
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Memory",
      "description": "Memory used by processes as a share of installed RAM (excludes kernel and ZFS cache). Dashed line: 90%, the alert threshold.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hrStorageSize{job=\"pfsense\", hrStorageDescr=\"Real Memory Metrics\"} * hrStorageAllocationUnits{job=\"pfsense\", hrStorageDescr=\"Real Memory Metrics\"}) / max(hrMemorySize{job=\"pfsense\"} * 1024) * 100",
          "legendFormat": "process memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "showPoints": "never",
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 26,
      "type": "row",
      "title": "Interfaces",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Interface traffic (rx up / tx down)",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 46
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "showPoints": "never",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* tx"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ifHCInOctets{job=\"pfsense\", ifName!~\"lo[0-9]*|enc[0-9]*|pflog[0-9]*|pfsync[0-9]*|ovpn.*|gif[0-9]*|gre[0-9]*\"}[$__rate_interval]) * 8 > 0",
          "legendFormat": "{{ifName}} rx"
        },
        {
          "refId": "B",
          "expr": "rate(ifHCOutOctets{job=\"pfsense\", ifName!~\"lo[0-9]*|enc[0-9]*|pflog[0-9]*|pfsync[0-9]*|ovpn.*|gif[0-9]*|gre[0-9]*\"}[$__rate_interval]) * 8 > 0",
          "legendFormat": "{{ifName}} tx"
        }
      ],
      "description": "WAN is the interface that carries most rx; blocked inbound traffic in the panels above shows on the same interface name."
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Interface errors + discards (range)",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 46
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "minVizHeight": 10,
        "maxVizHeight": 24
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "{{ifName}}",
          "expr": "sum by (ifName) (increase(ifInErrors{job=\"pfsense\", ifName!~\"lo[0-9]*|enc[0-9]*|pflog[0-9]*|pfsync[0-9]*|ovpn.*|gif[0-9]*|gre[0-9]*\"}[$__range]) + increase(ifOutErrors{job=\"pfsense\", ifName!~\"lo[0-9]*|enc[0-9]*|pflog[0-9]*|pfsync[0-9]*|ovpn.*|gif[0-9]*|gre[0-9]*\"}[$__range]) + increase(ifInDiscards{job=\"pfsense\", ifName!~\"lo[0-9]*|enc[0-9]*|pflog[0-9]*|pfsync[0-9]*|ovpn.*|gif[0-9]*|gre[0-9]*\"}[$__range]) + increase(ifOutDiscards{job=\"pfsense\", ifName!~\"lo[0-9]*|enc[0-9]*|pflog[0-9]*|pfsync[0-9]*|ovpn.*|gif[0-9]*|gre[0-9]*\"}[$__range])) and on (ifName) (ifOperStatus{job=\"pfsense\"} == 1)"
        }
      ],
      "description": "In and out errors plus discards per interface that is up, over the selected range. 0 everywhere is the normal state."
    },
    {
      "id": 16,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "panels": [],
