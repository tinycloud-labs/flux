{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images in HelmRelease values: a `repository:` line followed (within a few lines) by its `tag:` line",
      "managerFilePatterns": [
        "/^apps/[^/]+/release\\.ya?ml$/",
        "/^apps/[^/]+/(base|overlays/[^/]+)/[^/]+\\.ya?ml$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "repository:[ \\t]*[\"']?(?<depName>[^\\s\"'#]+)[\"']?[^\\n]*\\n(?:[^\\n]*\\n){0,3}?[ \\t]*tag:[ \\t]*[\"']?[^\\s\"'#]+[\"']?",
        "tag:[ \\t]*[\"']?(?<currentValue>[^\\s\"'#@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "autoReplaceStringTemplate": "tag: \"{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\"",
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "matchDatasources": ["docker"],
      "pinDigests": true
    }
  ]
}
